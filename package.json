{
  "name": "jira-timetracker-app",
  "private": true,
  "version": "0.18.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter-marien/Jira-TimeTracker.git"
  },
  "scripts": {
    "test": "node --import ./tests/register-paths.mjs --test \"tests/*.test.mjs\" \"src/**/*.test.ts\"",
    "test:sqlite": "node tests/native-sqlite.mjs",
    "test:electron": "node tests/run-electron-smoke.mjs",
    "test:app": "node tests/run-app-smoke.mjs",
    "test:packaged": "node tests/run-packaged-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build:app": "ng build && node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:app && electron-builder",
    "release": "npm run typecheck && npm run build:app && dotenv -e .env -- electron-builder --publish always",
    "release:build": "npm run typecheck && npm run build:app && electron-builder --win nsis --x64 --publish never",
    "lint": "eslint src electron --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.77.0",
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "node-machine-id": "^1.1.12",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "angular-eslint": "^22.0.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.pmarien.jira-timetracker",
    "productName": "Jira Time Tracker",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron",
      "public"
    ],
    "protocols": {
      "name": "Jira Time Tracker OAuth",
      "schemes": [
        "jira-timetracker-app"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "peter-marien",
      "repo": "Jira-TimeTracker"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-Linux-${version}.${ext}"
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
